{
  "1": {
    "inputs": {
      "ckpt_name": "hunyuan_3d_v2.1.safetensors"
    },
    "class_type": "ImageOnlyCheckpointLoader",
    "_meta": {
      "title": "Load Hunyuan3D v2.1 checkpoint"
    }
  },
  "2": {
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference image (auto_rigger_cli.py replaces this)"
    }
  },
  "3": {
    "inputs": {
      "shift": 1.0,
      "model": ["1", 0]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "Model sampling"
    }
  },
  "4": {
    "inputs": {
      "resolution": 3072,
      "batch_size": 1
    },
    "class_type": "EmptyLatentHunyuan3Dv2",
    "_meta": {
      "title": "Empty 3D latent"
    }
  },
  "5": {
    "inputs": {
      "crop": "center",
      "clip_vision": ["1", 1],
      "image": ["2", 0]
    },
    "class_type": "CLIPVisionEncode",
    "_meta": {
      "title": "Encode reference image"
    }
  },
  "6": {
    "inputs": {
      "clip_vision_output": ["5", 0]
    },
    "class_type": "Hunyuan3Dv2Conditioning",
    "_meta": {
      "title": "Hunyuan3D conditioning"
    }
  },
  "7": {
    "inputs": {
      "seed": 123456789,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Generate geometry"
    }
  },
  "8": {
    "inputs": {
      "num_chunks": 8000,
      "octree_resolution": 256,
      "samples": ["7", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecodeHunyuan3D",
    "_meta": {
      "title": "Decode to voxels"
    }
  },
  "9": {
    "inputs": {
      "algorithm": "surface net",
      "threshold": 0.6,
      "voxel": ["8", 0]
    },
    "class_type": "VoxelToMesh",
    "_meta": {
      "title": "Voxels to mesh"
    }
  },
  "10": {
    "inputs": {
      "filename_prefix": "autorig/mesh",
      "mesh": ["9", 0]
    },
    "class_type": "SaveGLB",
    "_meta": {
      "title": "Save GLB (auto_rigger_cli.py downloads this)"
    }
  }
}
